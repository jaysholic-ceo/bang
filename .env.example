# 환경변수 이름만 적은 예시입니다. 값은 넣지 않습니다.
# 모두 선택 사항이고, 없어도 빌드와 실행이 됩니다(분석 스크립트가 꺼진 상태로 동작).
# 실제 값은 Vercel 환경변수와 사용자 컴퓨터의 .env.local 에만 있습니다.

# Google Analytics 4 측정 ID
NEXT_PUBLIC_GA_ID=

# 네이버 검색광고 전환추적 사이트 ID
NEXT_PUBLIC_NAVER_WCS_ID=

# 구글 애즈 전환 ID / 라벨 (전화·지도·예약)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GADS_CALL_LABEL=
NEXT_PUBLIC_GADS_MAP_LABEL=
NEXT_PUBLIC_GADS_BOOKING_LABEL=
